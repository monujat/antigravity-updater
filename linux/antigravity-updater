#!/usr/bin/env bash
# ==============================================================================
# Antigravity IDE - Smart Updater Frontend (GUI & CLI)
# Part of the Antigravity IDE Updater suite (https://github.com/monujat/antigravity-updater)
#
# Automatically detects new downloads or dropped packages, handles elevation,
# and invokes the core update engine with visual progress.
# ==============================================================================

set -o pipefail

ENGINE_PATH="${ANTIGRAVITY_ENGINE_PATH:-$HOME/.local/bin/antigravity-update-engine}"
DROPZONE_DIR="${ANTIGRAVITY_DROPZONE:-$HOME/Antigravity-Update-Box}"
DOWNLOADS_DIR="${ANTIGRAVITY_DOWNLOADS:-$HOME/Downloads}"
ICON_PATH="/usr/share/pixmaps/antigravity.png"

# Fallback engine path check
if [ ! -f "$ENGINE_PATH" ]; then
    if [ -f "/usr/local/bin/antigravity-update-engine" ]; then
        ENGINE_PATH="/usr/local/bin/antigravity-update-engine"
    fi
fi

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ------------------------------------------------------------------------------
# Locate latest Antigravity update candidate
# ------------------------------------------------------------------------------
find_candidate() {
    local candidate=""

    # 1. Check Dropzone folder first (highest priority)
    if [ -d "$DROPZONE_DIR" ]; then
        # Check archives in Dropzone
        candidate=$(find "$DROPZONE_DIR" -maxdepth 2 -type f \( -iname "*antigravity*.tar.gz" -o -iname "*antigravity*.tgz" -o -iname "*antigravity*.tar.xz" -o -iname "*antigravity*.zip" \) -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)
        if [ -n "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
        # Check directories in Dropzone
        candidate=$(find "$DROPZONE_DIR" -maxdepth 2 -mindepth 1 -type d \( -iname "*antigravity*" \) -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)
        if [ -n "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    fi

    # 2. Check Downloads folder
    if [ -d "$DOWNLOADS_DIR" ]; then
        # Check archives in Downloads
        candidate=$(find "$DOWNLOADS_DIR" -maxdepth 2 -type f \( -iname "*antigravity*.tar.gz" -o -iname "*antigravity*.tgz" -o -iname "*antigravity*.tar.xz" -o -iname "*antigravity*.zip" \) -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)
        if [ -n "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
        # Check directories in Downloads
        candidate=$(find "$DOWNLOADS_DIR" -maxdepth 2 -mindepth 1 -type d \( -iname "*antigravity*" \) -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)
        if [ -n "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    fi

    return 1
}

# ------------------------------------------------------------------------------
# Format file details for display
# ------------------------------------------------------------------------------
get_file_info() {
    local target="$1"
    local size
    local date
    if [ -d "$target" ]; then
        size=$(du -sh "$target" 2>/dev/null | cut -f1)
        date=$(stat -c "%y" "$target" 2>/dev/null | cut -d'.' -f1)
        echo -e "Directory: $(basename "$target")\nSize: $size\nModified: $date\nPath: $target"
    else
        size=$(du -sh "$target" 2>/dev/null | cut -f1)
        date=$(stat -c "%y" "$target" 2>/dev/null | cut -d'.' -f1)
        echo -e "File: $(basename "$target")\nSize: $size\nModified: $date\nPath: $target"
    fi
}

# ------------------------------------------------------------------------------
# GUI Update Execution
# ------------------------------------------------------------------------------
run_gui() {
    local source="$1"

    # If no source provided as argument, auto-detect
    if [ -z "$source" ]; then
        source=$(find_candidate || true)
    fi

    if [ -n "$source" ] && [ -e "$source" ]; then
        local info
        info=$(get_file_info "$source")
        
        local choice
        choice=$(zenity --question \
            --title="Antigravity IDE Updater" \
            --window-icon="$ICON_PATH" \
            --text="<b>Found Antigravity update package:</b>\n\n$info\n\nWould you like to update Antigravity IDE now?" \
            --ok-label="Update Now" \
            --cancel-label="Cancel" \
            --extra-button="Choose Other File..." 2>&1)
        local status=$?

        if [ "$choice" = "Choose Other File..." ]; then
            source=""
        elif [ $status -ne 0 ]; then
            # User pressed Cancel
            exit 0
        fi
    fi

    # If still no source (either none found or user opted to choose another)
    if [ -z "$source" ]; then
        if ! source=$(zenity --file-selection \
            --title="Select Antigravity IDE Archive or Folder" \
            --window-icon="$ICON_PATH" \
            --file-filter="Antigravity packages | *.tar.gz *.tgz *.tar.xz *.zip" \
            --file-filter="All files | *" 2>/dev/null) || [ -z "$source" ]; then
            exit 0
        fi
    fi

    # Perform the update with live progress bar and root elevation
    local log_file
    log_file=$(mktemp /tmp/antigravity_update_XXXXXX.log)
    local success=0

    # 1. Try pkexec
    if command -v pkexec >/dev/null 2>&1; then
        (
            pkexec "$ENGINE_PATH" "$source" 2>&1 | tee "$log_file"
            echo "${PIPESTATUS[0]}" > "$log_file.code"
        ) | zenity --progress \
            --title="Updating Antigravity IDE" \
            --window-icon="$ICON_PATH" \
            --text="Starting update..." \
            --auto-close \
            --no-cancel \
            --percentage=0

        local code
        code=$(cat "$log_file.code" 2>/dev/null || echo "1")
        if [ "$code" -eq 0 ]; then
            success=1
        fi
    fi

    # 2. Fallback to Zenity password prompt with sudo -S if pkexec was cancelled or failed
    if [ $success -ne 1 ]; then
        local attempts=0
        while [ $attempts -lt 3 ]; do
            local pass
            if ! pass=$(zenity --password \
                --title="Administrator Authentication Required" \
                --window-icon="$ICON_PATH") || [ -z "$pass" ]; then
                rm -f "$log_file" "$log_file.code" 2>/dev/null
                exit 0
            fi

            if echo "$pass" | sudo -S -k true 2>/dev/null; then
                (
                    echo "$pass" | sudo -S "$ENGINE_PATH" "$source" 2>&1 | tee "$log_file"
                    echo "${PIPESTATUS[1]}" > "$log_file.code"
                ) | zenity --progress \
                    --title="Updating Antigravity IDE" \
                    --window-icon="$ICON_PATH" \
                    --text="Updating Antigravity IDE..." \
                    --auto-close \
                    --no-cancel \
                    --percentage=0

                local code
                code=$(cat "$log_file.code" 2>/dev/null || echo "1")
                if [ "$code" -eq 0 ]; then
                    success=1
                    break
                else
                    break
                fi
            else
                attempts=$((attempts + 1))
                zenity --error \
                    --title="Authentication Failed" \
                    --window-icon="$ICON_PATH" \
                    --text="Incorrect password. Please try again ($attempts/3)."
            fi
        done
    fi

    if [ $success -eq 1 ]; then
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "Antigravity IDE Updated" "Successfully updated to the latest version!" -i "$ICON_PATH" 2>/dev/null || true
        fi

        local launch_action
        launch_action=$(zenity --info \
            --title="Update Complete" \
            --window-icon="$ICON_PATH" \
            --text="<b>Antigravity IDE updated successfully!</b>\n\n<b>Installed to:</b> /usr/share/antigravity\n<b>Backup saved at:</b> /usr/share/antigravity.bak" \
            --ok-label="Launch Antigravity" \
            --extra-button="Close" 2>&1)

        if [ "$launch_action" != "Close" ]; then
            nohup /usr/bin/antigravity >/dev/null 2>&1 &
        fi
    else
        local err_msg
        err_msg=$(tail -n 10 "$log_file" 2>/dev/null || echo "An unexpected error occurred.")
        zenity --error \
            --title="Update Failed" \
            --window-icon="$ICON_PATH" \
            --text="<b>Failed to update Antigravity IDE:</b>\n\n$err_msg"
    fi

    rm -f "$log_file" "$log_file.code" 2>/dev/null
}

# ------------------------------------------------------------------------------
# CLI Update Execution
# ------------------------------------------------------------------------------
run_cli() {
    local source="$1"

    echo -e "${BLUE}${BOLD}=== Antigravity IDE Updater ===${NC}"

    if [ -z "$source" ]; then
        source=$(find_candidate || true)
    fi

    if [ -n "$source" ] && [ -e "$source" ]; then
        echo -e "${YELLOW}Found update package:${NC} $source"
        read -r -p "Do you want to update Antigravity IDE with this package? [Y/n] " response
        response=${response:-Y}
        if [[ ! "$response" =~ ^[Yy]$ ]]; then
            read -r -p "Enter path to update archive or folder: " source
        fi
    else
        read -r -p "Enter path to update archive or folder: " source
    fi

    if [ ! -e "$source" ]; then
        echo -e "${RED}Error: Path '$source' does not exist.${NC}"
        exit 1
    fi

    echo -e "${GREEN}Starting update from: $source...${NC}"
    sudo "$ENGINE_PATH" "$source"

    echo -e "${GREEN}${BOLD}Antigravity IDE successfully updated!${NC}"
    echo -e "You can launch it anytime by running: ${BLUE}antigravity${NC}"
}

# ------------------------------------------------------------------------------
# Entry Point
# ------------------------------------------------------------------------------
# If running with explicit --cli or outside X11/Wayland or zenity is missing, use CLI
if [ "$1" = "--cli" ] || { [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; } || ! command -v zenity >/dev/null 2>&1; then
    if [ "$1" = "--cli" ]; then
        shift
    fi
    run_cli "$1"
else
    run_gui "$1"
fi
